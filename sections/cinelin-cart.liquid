{{ 'cinelin-tokens.css' | asset_url | stylesheet_tag }}
{{ 'cinelin-pages.css' | asset_url | stylesheet_tag }}
{{ 'cinelin-cart.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cinelin-pages.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign nav_menu_id = 'CinelinCartMenu-' | append: section.id
-%}

<section class="cinelin-page cinelin-cart" data-cinelin-page>
  {%- render 'cinelin-page-nav',
    nav_label: 'Cart navigation',
    page_label: 'Cart',
    brand_name: section.settings.brand_name,
    menu_id: nav_menu_id
  -%}

  <div class="cinelin-cart__shell">
    <header class="cinelin-cart__hero">
      <div>
        <p class="cinelin-page__kicker">{{ section.settings.kicker | escape }}</p>
        <h1>{{ section.settings.title | escape }}</h1>
      </div>
      <div>
        <p class="cinelin-cart__intro">{{ section.settings.intro | escape }}</p>
        <p class="cinelin-cart__copy">{{ section.settings.copy | escape }}</p>
      </div>
    </header>

    {%- if cart == empty -%}
      <div class="cinelin-cart__empty">
        <p class="cinelin-page__eyebrow">{{ section.settings.empty_kicker | escape }}</p>
        <h2>{{ section.settings.empty_title | escape }}</h2>
        <a class="cinelin-page__button" href="{{ routes.all_products_collection_url }}">{{ section.settings.empty_link_label | escape }}</a>
      </div>
    {%- else -%}
      <form class="cinelin-cart__form" action="{{ routes.cart_url }}" method="post" id="CinelinCart">
        <div class="cinelin-cart__items" aria-label="Cart line items">
          {%- for item in cart.items -%}
            <article class="cinelin-cart__item" id="CartItem-{{ item.index | plus: 1 }}">
              <a class="cinelin-cart__media" href="{{ item.url }}" aria-label="{{ item.product.title | escape }}">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 500 | image_tag:
                    loading: 'lazy',
                    widths: '180, 260, 360, 500',
                    sizes: '(min-width: 750px) 12rem, 32vw',
                    alt: item.image.alt
                  }}
                {%- else -%}
                  <span aria-hidden="true"></span>
                {%- endif -%}
              </a>

              <div class="cinelin-cart__details">
                <a class="cinelin-cart__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cinelin-cart__variant">
                    {%- for option in item.options_with_values -%}
                      {{ option.name }}: {{ option.value }}{% unless forloop.last %} / {% endunless %}
                    {%- endfor -%}
                  </p>
                {%- endunless -%}
                {%- if item.properties.size > 0 -%}
                  <dl class="cinelin-cart__properties">
                    {%- for property in item.properties -%}
                      {%- assign property_first_char = property.first | slice: 0 -%}
                      {%- if property.last != blank and property_first_char != '_' -%}
                        <div>
                          <dt>{{ property.first }}:</dt>
                          <dd>{{ property.last }}</dd>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </dl>
                {%- endif -%}
                <a class="cinelin-cart__remove" href="{{ item.url_to_remove }}">Remove</a>
              </div>

              <div class="cinelin-cart__quantity">
                <label class="visually-hidden" for="Quantity-{{ item.index | plus: 1 }}">Quantity for {{ item.product.title | escape }}</label>
                <input
                  id="Quantity-{{ item.index | plus: 1 }}"
                  class="cinelin-cart__quantity-input"
                  type="number"
                  name="updates[]"
                  value="{{ item.quantity }}"
                  min="0"
                  aria-label="Quantity for {{ item.product.title | escape }}"
                >
              </div>

              <div class="cinelin-cart__line-price">
                {%- if item.original_line_price != item.final_line_price -%}
                  <s>{{ item.original_line_price | money }}</s>
                {%- endif -%}
                <strong>{{ item.final_line_price | money }}</strong>
              </div>
            </article>
          {%- endfor -%}
        </div>

        <aside class="cinelin-cart__summary" aria-label="Cart summary">
          <p class="cinelin-page__eyebrow">{{ section.settings.summary_kicker | escape }}</p>
          <div class="cinelin-cart__subtotal">
            <span>{{ section.settings.subtotal_label | escape }}</span>
            <strong>{{ cart.total_price | money_with_currency }}</strong>
          </div>

          {%- if cart.cart_level_discount_applications.size > 0 -%}
            <ul class="cinelin-cart__discounts" role="list">
              {%- for discount in cart.cart_level_discount_applications -%}
                <li>{{ discount.title | escape }} (-{{ discount.total_allocated_amount | money }})</li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <p class="cinelin-cart__checkout-note">{{ section.settings.checkout_note | escape }}</p>
          <button class="cinelin-cart__update" type="submit" name="update">{{ section.settings.update_label | escape }}</button>
          <button class="cinelin-cart__checkout" type="submit" name="checkout">{{ section.settings.checkout_label | escape }}</button>
        </aside>
      </form>
    {%- endif -%}

    {%- render 'cinelin-footer',
      footer_label: section.settings.brand_name,
      footer_note: section.settings.footer_note
    -%}
  </div>
</section>

{% schema %}
{
  "name": "Cinelin cart",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "MILK & ROSE" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Cart" },
    { "type": "text", "id": "title", "label": "Title", "default": "Held objects" },
    { "type": "text", "id": "intro", "label": "Intro", "default": "A final look before the handoff." },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "Review the pieces, adjust quantities, then continue through Shopify's native checkout." },
    { "type": "text", "id": "empty_kicker", "label": "Empty cart kicker", "default": "No objects yet" },
    { "type": "text", "id": "empty_title", "label": "Empty cart title", "default": "Your cart is still quiet." },
    { "type": "text", "id": "empty_link_label", "label": "Empty cart link label", "default": "View collection" },
    { "type": "text", "id": "summary_kicker", "label": "Summary kicker", "default": "Summary" },
    { "type": "text", "id": "subtotal_label", "label": "Subtotal label", "default": "Subtotal" },
    { "type": "textarea", "id": "checkout_note", "label": "Checkout note", "default": "Checkout is handled by Shopify. Standard plans do not support fully custom checkout UI." },
    { "type": "text", "id": "update_label", "label": "Update button label", "default": "Update cart" },
    { "type": "text", "id": "checkout_label", "label": "Checkout button label", "default": "Checkout" },
    { "type": "text", "id": "footer_note", "label": "Footer note", "default": "Objects made slowly, kept close." }
  ],
  "presets": [
    { "name": "Cinelin cart" }
  ]
}
{% endschema %}
