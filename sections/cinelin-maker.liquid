{{ 'cinelin-tokens.css' | asset_url | stylesheet_tag }}
{{ 'cinelin-pages.css' | asset_url | stylesheet_tag }}
{{ 'cinelin-maker.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cinelin-pages.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign nav_menu_id = 'CinelinMakerMenu-' | append: section.id
-%}

<section class="cinelin-page cinelin-maker" data-cinelin-page>
  {%- render 'cinelin-page-nav',
    nav_label: 'Maker profile navigation',
    page_label: 'Maker',
    brand_name: section.settings.brand_name,
    menu_id: nav_menu_id
  -%}

  <div class="cinelin-maker__shell">
    <header class="cinelin-maker__hero">
      <div class="cinelin-maker__portrait" aria-label="{{ section.settings.portrait_alt | escape }}">
        {%- if section.settings.portrait != blank -%}
          {{ section.settings.portrait | image_url: width: 1100 | image_tag:
            loading: 'lazy',
            widths: '360, 540, 720, 900, 1100',
            sizes: '(min-width: 990px) 42vw, 100vw',
            alt: section.settings.portrait_alt
          }}
        {%- else -%}
          <span aria-hidden="true"></span>
        {%- endif -%}
      </div>

      <div class="cinelin-maker__intro">
        <p class="cinelin-page__kicker">{{ section.settings.kicker | escape }}</p>
        <h1>{{ section.settings.name | escape }}</h1>
        <p class="cinelin-maker__role">{{ section.settings.role | escape }}</p>
        <p class="cinelin-maker__location">{{ section.settings.location | escape }}</p>
        <p class="cinelin-maker__bio">{{ section.settings.bio | escape }}</p>
      </div>
    </header>

    <section class="cinelin-maker__note" aria-labelledby="CinelinMakerNote-{{ section.id }}">
      <p class="cinelin-page__eyebrow">{{ section.settings.note_kicker | escape }}</p>
      <h2 id="CinelinMakerNote-{{ section.id }}">{{ section.settings.note_title | escape }}</h2>
      <p>{{ section.settings.note_copy | escape }}</p>
    </section>

    <section class="cinelin-maker__pieces" aria-labelledby="CinelinMakerPieces-{{ section.id }}">
      <div class="cinelin-page__toolbar">
        <span id="CinelinMakerPieces-{{ section.id }}">{{ section.settings.pieces_label | escape }}</span>
        <span>{{ section.blocks.size | default: 4 }} pieces</span>
      </div>

      <div class="cinelin-page__grid" data-cinelin-product-grid>
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign card_product = block.settings.product
              assign card_title = block.settings.title
              assign card_price = block.settings.price
              assign card_link = block.settings.link
              if card_product != blank
                assign card_title = card_product.title
                assign card_price = card_product.price | money
                assign card_link = card_product.url
              endif
              if card_title == blank
                assign card_title = 'Studio piece'
              endif
              if card_price == blank
                assign card_price = 'Coming soon'
              endif
              if card_link == blank
                assign card_link = routes.all_products_collection_url
              endif
            -%}
            <article class="cinelin-card" data-cinelin-model-card {{ block.shopify_attributes }}>
              <button class="cinelin-card__media" type="button" aria-label="Spin {{ card_title | escape }} 3D model" data-cinelin-model-button>
                <span class="cinelin-card__model">
                  <span class="cinelin-card__gem"></span>
                  <span class="cinelin-card__ring"></span>
                  <span class="cinelin-card__stone"></span>
                  <span class="cinelin-card__shadow"></span>
                </span>
              </button>
              <a class="cinelin-card__body" href="{{ card_link }}">
                <span class="cinelin-card__title">{{ card_title | escape }}</span>
                <span class="cinelin-card__price">{{ card_price | escape }}</span>
              </a>
            </article>
          {%- endfor -%}
        {%- else -%}
          {%- for index in (1..4) -%}
            <article class="cinelin-card" data-cinelin-model-card>
              <button class="cinelin-card__media" type="button" aria-label="Spin maker piece {{ index }} 3D model" data-cinelin-model-button>
                <span class="cinelin-card__model">
                  <span class="cinelin-card__gem"></span>
                  <span class="cinelin-card__ring"></span>
                  <span class="cinelin-card__stone"></span>
                  <span class="cinelin-card__shadow"></span>
                </span>
              </button>
              <a class="cinelin-card__body" href="{{ routes.all_products_collection_url }}">
                <span class="cinelin-card__title">Maker piece {{ index }}</span>
                <span class="cinelin-card__price">Coming soon</span>
              </a>
            </article>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </section>

    {%- render 'cinelin-footer',
      footer_label: section.settings.brand_name,
      footer_note: section.settings.footer_note
    -%}
  </div>
</section>

{% schema %}
{
  "name": "Cinelin maker profile",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "MILK & ROSE" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Maker profile" },
    { "type": "image_picker", "id": "portrait", "label": "Portrait" },
    { "type": "text", "id": "portrait_alt", "label": "Portrait alt text", "default": "Portrait of the artisan" },
    { "type": "text", "id": "name", "label": "Name", "default": "Ayla Demir" },
    { "type": "text", "id": "role", "label": "Role", "default": "Metalsmith and stone setter" },
    { "type": "text", "id": "location", "label": "Location", "default": "Türkiye" },
    { "type": "textarea", "id": "bio", "label": "Bio", "default": "Ayla works slowly at a small bench, shaping each piece until it feels like it has already lived a little. Her pieces keep the trace of the hand without losing their clean line." },
    { "type": "text", "id": "note_kicker", "label": "Editorial note kicker", "default": "Studio note" },
    { "type": "text", "id": "note_title", "label": "Editorial note title", "default": "The work is quiet, but never anonymous." },
    { "type": "textarea", "id": "note_copy", "label": "Editorial note copy", "default": "This profile is a placeholder for the final artisan interview. It sets the rhythm: portrait first, then material, location, and the pieces that came from the same hands." },
    { "type": "text", "id": "pieces_label", "label": "Pieces label", "default": "Pieces by this maker" },
    { "type": "text", "id": "footer_note", "label": "Footer note", "default": "Objects made slowly, kept close." }
  ],
  "blocks": [
    {
      "type": "maker_piece",
      "name": "Maker piece",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "title", "label": "Fallback title", "default": "Pearl loop" },
        { "type": "text", "id": "price", "label": "Fallback price", "default": "Coming soon" },
        { "type": "url", "id": "link", "label": "Fallback link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cinelin maker profile",
      "blocks": [
        { "type": "maker_piece" },
        { "type": "maker_piece", "settings": { "title": "Green drop" } },
        { "type": "maker_piece", "settings": { "title": "Rose charm" } },
        { "type": "maker_piece", "settings": { "title": "Gold orbit" } }
      ]
    }
  ]
}
{% endschema %}
