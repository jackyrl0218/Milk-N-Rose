{{ 'cinelin-tokens.css' | asset_url | stylesheet_tag }}
{{ 'cinelin-pages.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cinelin-pages.js' | asset_url }}" defer="defer"></script>

<section class="cinelin-page cinelin-page--about" data-cinelin-page>
  <div class="cinelin-page__shell">
    <nav class="cinelin-page__topline" aria-label="Page navigation">
      <div class="cinelin-page__left-actions">
        <button class="cinelin-page__menu-button" type="button" data-cinelin-menu-toggle aria-controls="CinelinPageMenu-{{ section.id }}" aria-expanded="false">
          <span class="visually-hidden">Open menu</span>
          {{ 'icon-hamburger.svg' | inline_asset_content }}
        </button>
      </div>
      <nav class="cinelin-page__topnav" aria-label="Primary navigation">
        <a href="{{ routes.all_products_collection_url }}">Maker</a>
        <a href="{{ routes.all_products_collection_url }}">Collection</a>
        <a href="/pages/about">About</a>
        <a href="/pages/contact">Contact</a>
      </nav>
      <a class="cinelin-page__topline-brand" href="{{ routes.root_url }}">X</a>
      <div class="cinelin-page__actions">
        <a class="cinelin-page__utility-link" href="{{ routes.all_products_collection_url }}">Shop</a>
        <a class="cinelin-page__icon-button" href="{{ routes.account_url }}" aria-label="Account">
          {{ 'icon-account.svg' | inline_asset_content }}
        </a>
        <a class="cinelin-page__icon-button" href="{{ routes.cart_url }}" aria-label="Cart">
          {{ 'icon-cart.svg' | inline_asset_content }}
        </a>
      </div>
      <div class="cinelin-page__menu-list" id="CinelinPageMenu-{{ section.id }}" data-cinelin-menu>
        <div class="cinelin-page__menu-nav">
          <a href="{{ routes.root_url }}">Home</a>
          <a href="{{ routes.all_products_collection_url }}">Maker</a>
          <a href="{{ routes.all_products_collection_url }}">Collection</a>
          <a href="/pages/about">About</a>
          <a href="/pages/contact">Contact</a>
          <a href="{{ routes.cart_url }}">Cart</a>
        </div>
      </div>
    </nav>

    <header class="cinelin-about-layout">
      <div class="cinelin-about-layout__left">
        <div class="cinelin-about-layout__intro">
          <div class="cinelin-about-layout__thumb">
            {%- if section.settings.thumbnail_image != blank -%}
              {{
                section.settings.thumbnail_image
                | image_url: width: 900
                | image_tag:
                  loading: 'eager',
                  widths: '320, 480, 640, 900',
                  sizes: '(min-width: 990px) 24vw, 44vw',
                  alt: section.settings.thumbnail_alt
              }}
            {%- else -%}
              <img src="{{ 'cinelin-collection-hero.jpg' | asset_url }}" alt="{{ section.settings.thumbnail_alt | escape }}" loading="eager">
            {%- endif -%}
          </div>
          <div class="cinelin-about-layout__copy">
            <p class="cinelin-about-layout__kicker">{{ section.settings.kicker | escape }}</p>
            <h1>{{ section.settings.title | escape }}</h1>
            <p>{{ section.settings.copy | escape }}</p>
            <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="cinelin-about-layout__link">
              {{ section.settings.cta_label | escape }}
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        <dl class="cinelin-about-layout__details">
          <div>
            <dt>{{ section.settings.detail_one_label | escape }}</dt>
            <dd>{{ section.settings.detail_one_text | escape }}</dd>
          </div>
          <div>
            <dt>{{ section.settings.detail_two_label | escape }}</dt>
            <dd>{{ section.settings.detail_two_text | newline_to_br }}</dd>
          </div>
          <div>
            <dt>{{ section.settings.detail_three_label | escape }}</dt>
            <dd>{{ section.settings.detail_three_text | escape }}</dd>
          </div>
        </dl>
      </div>

      <div class="cinelin-about-layout__right" aria-label="{{ section.settings.hero_alt | escape }}">
        {%- if section.settings.hero_image != blank -%}
          {{
            section.settings.hero_image
            | image_url: width: 1800
            | image_tag:
              loading: 'eager',
              widths: '640, 900, 1200, 1500, 1800',
              sizes: '(min-width: 990px) 50vw, 100vw',
              alt: section.settings.hero_alt
          }}
        {%- else -%}
          <img src="{{ 'cinelin-collection-hero.jpg' | asset_url }}" alt="{{ section.settings.hero_alt | escape }}" loading="eager">
        {%- endif -%}
        <span>{{ section.settings.scroll_hint | escape }}</span>
      </div>
    </header>

    <section class="cinelin-about-film" aria-labelledby="CinelinAboutFilm-{{ section.id }}">
      <div class="cinelin-about-film__media">
        {%- if section.settings.brand_video != blank -%}
          {{
            section.settings.brand_video
            | video_tag:
              image_size: '1600x',
              autoplay: true,
              loop: true,
              muted: true,
              controls: true,
              playsinline: true
          }}
        {%- elsif section.settings.film_image != blank -%}
          {{
            section.settings.film_image
            | image_url: width: 1800
            | image_tag:
              loading: 'lazy',
              widths: '640, 900, 1200, 1500, 1800',
              sizes: '(min-width: 990px) 58vw, 100vw',
              alt: section.settings.film_alt
          }}
          <span class="cinelin-about-film__play" aria-hidden="true">Play</span>
        {%- else -%}
          <img src="{{ 'cinelin-collection-hero.png' | asset_url }}" alt="{{ section.settings.film_alt | escape }}" loading="lazy">
          <span class="cinelin-about-film__play" aria-hidden="true">Play</span>
        {%- endif -%}
      </div>
      <div class="cinelin-about-film__copy">
        <p class="cinelin-about-layout__kicker">{{ section.settings.film_kicker | escape }}</p>
        <h2 id="CinelinAboutFilm-{{ section.id }}">{{ section.settings.film_title | escape }}</h2>
        <p>{{ section.settings.film_copy | escape }}</p>
      </div>
    </section>
  </div>
</section>

{% schema %}
{
  "name": "Cinelin about",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Brand story"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "We believe jewelry should feel intimate before it feels precious."
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Copy",
      "default": "Every piece starts as a small study in contrast: soft curves, bright edges, quiet detail, and a finish made to live close to the skin."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Link label",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link"
    },
    {
      "type": "image_picker",
      "id": "thumbnail_image",
      "label": "Intro image"
    },
    {
      "type": "text",
      "id": "thumbnail_alt",
      "label": "Intro image alt text",
      "default": "Soft editorial jewelry detail"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Large right image"
    },
    {
      "type": "text",
      "id": "hero_alt",
      "label": "Large right image alt text",
      "default": "Editorial model image for the Cinelin brand"
    },
    {
      "type": "text",
      "id": "scroll_hint",
      "label": "Scroll hint",
      "default": "Scroll for the story"
    },
    {
      "type": "text",
      "id": "detail_one_label",
      "label": "First detail label",
      "default": "Services"
    },
    {
      "type": "text",
      "id": "detail_one_text",
      "label": "First detail text",
      "default": "Handmade jewelry / Small-batch drops / Custom moments"
    },
    {
      "type": "text",
      "id": "detail_two_label",
      "label": "Second detail label",
      "default": "Studio"
    },
    {
      "type": "textarea",
      "id": "detail_two_text",
      "label": "Second detail text",
      "default": "Slow fabrication\nSoft polish\nMade with care"
    },
    {
      "type": "text",
      "id": "detail_three_label",
      "label": "Third detail label",
      "default": "Materials"
    },
    {
      "type": "text",
      "id": "detail_three_text",
      "label": "Third detail text",
      "default": "Sterling silver / Gold tones / Found textures"
    },
    {
      "type": "header",
      "content": "Brand film"
    },
    {
      "type": "video",
      "id": "brand_video",
      "label": "Brand video"
    },
    {
      "type": "image_picker",
      "id": "film_image",
      "label": "Fallback film image"
    },
    {
      "type": "text",
      "id": "film_alt",
      "label": "Film image alt text",
      "default": "Brand film preview"
    },
    {
      "type": "text",
      "id": "film_kicker",
      "label": "Film kicker",
      "default": "The brand"
    },
    {
      "type": "text",
      "id": "film_title",
      "label": "Film title",
      "default": "A quiet ritual of making, polishing, and choosing what stays."
    },
    {
      "type": "textarea",
      "id": "film_copy",
      "label": "Film copy",
      "default": "Use this space for a short brand video, studio footage, or a poetic material story. Until final assets arrive, the page behaves like a film still so the rhythm and mood are already locked."
    }
  ],
  "presets": [
    {
      "name": "Cinelin about"
    }
  ]
}
{% endschema %}
