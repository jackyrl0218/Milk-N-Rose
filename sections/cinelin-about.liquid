{{ 'cinelin-tokens.css' | asset_url | stylesheet_tag }}
{{ 'cinelin-pages.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cinelin-pages.js' | asset_url }}" defer="defer"></script>

<section class="cinelin-page cinelin-page--about" data-cinelin-page>
  <div class="cinelin-page__shell">
    <nav class="cinelin-page__topline" aria-label="Page navigation">
      <button class="cinelin-page__menu-button" type="button" data-cinelin-menu-toggle aria-controls="CinelinPageMenu-{{ section.id }}" aria-expanded="false">
        <span class="visually-hidden">Open menu</span>
        {{ 'icon-hamburger.svg' | inline_asset_content }}
      </button>
      <a class="cinelin-page__topline-brand" href="{{ routes.root_url }}">X</a>
      <div class="cinelin-page__actions">
        <span class="cinelin-page__topline-meta">About</span>
      </div>
      <div class="cinelin-page__menu-list" id="CinelinPageMenu-{{ section.id }}" data-cinelin-menu>
        <div class="cinelin-page__menu-nav">
          <a href="{{ routes.root_url }}">Home</a>
          <a href="{{ routes.all_products_collection_url }}">Product</a>
          <a href="{{ routes.all_products_collection_url }}">Maker</a>
          <a href="{{ routes.all_products_collection_url }}">Collection</a>
          <a href="/pages/about">About</a>
          <a href="{{ routes.cart_url }}">Cart</a>
          <a href="/pages/contact">Contact</a>
        </div>
      </div>
    </nav>

    <header class="cinelin-page__hero">
      <div>
        <p class="cinelin-page__kicker">{{ section.settings.kicker | escape }}</p>
        <h1 class="cinelin-page__title">{{ section.settings.title | escape }}</h1>
      </div>
      <div>
        <p class="cinelin-page__intro">{{ section.settings.intro | escape }}</p>
        <p class="cinelin-page__copy">{{ section.settings.copy | escape }}</p>
      </div>
    </header>

    <div class="cinelin-story">
      <article class="cinelin-story__panel">
        <p class="cinelin-page__eyebrow">{{ section.settings.panel_one_kicker | escape }}</p>
        <h2 class="cinelin-story__title">{{ section.settings.panel_one_title | escape }}</h2>
        <p class="cinelin-page__copy">{{ section.settings.panel_one_copy | escape }}</p>
      </article>
      <article class="cinelin-story__panel">
        <p class="cinelin-page__eyebrow">{{ section.settings.panel_two_kicker | escape }}</p>
        <h2 class="cinelin-story__title">{{ section.settings.panel_two_title | escape }}</h2>
        <p class="cinelin-page__copy">{{ section.settings.panel_two_copy | escape }}</p>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cinelin about",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "About / Brand story"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "X"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Intro",
      "default": "Jewelry made slowly, with a little tension between softness and shine."
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Copy",
      "default": "This page is a placeholder for the brand story while the final voice, photography, and maker details are still being prepared."
    },
    {
      "type": "text",
      "id": "panel_one_kicker",
      "label": "First panel kicker",
      "default": "Material"
    },
    {
      "type": "text",
      "id": "panel_one_title",
      "label": "First panel title",
      "default": "Small objects, close attention."
    },
    {
      "type": "textarea",
      "id": "panel_one_copy",
      "label": "First panel copy",
      "default": "The design system leaves room for real photos and final materials later. For now, the layout locks the mood: dark, minimal, crafted."
    },
    {
      "type": "text",
      "id": "panel_two_kicker",
      "label": "Second panel kicker",
      "default": "Feeling"
    },
    {
      "type": "text",
      "id": "panel_two_title",
      "label": "Second panel title",
      "default": "Simple to use. Hard to forget."
    },
    {
      "type": "textarea",
      "id": "panel_two_copy",
      "label": "Second panel copy",
      "default": "The page keeps the brand premium without becoming loud: clear words, strong spacing, and a gallery-like rhythm."
    }
  ],
  "presets": [
    {
      "name": "Cinelin about"
    }
  ]
}
{% endschema %}
