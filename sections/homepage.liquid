{{ 'cinelin-tokens.css' | asset_url | stylesheet_tag }}
{{ 'homepage.css' | asset_url | stylesheet_tag }}
<script src="{{ 'homepage.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign model_blocks = section.blocks | where: 'type', 'model_item'
  assign featured_blocks = section.blocks | where: 'type', 'featured_piece'
  assign model_count = model_blocks.size
  assign video_image = section.settings.video_image
  assign default_menu_link = section.settings.default_menu_link | default: routes.all_products_collection_url
  if model_count == 0
    assign model_count = 8
  endif
-%}

<section
  id="Homepage-{{ section.id }}"
  class="homepage"
  data-homepage
  data-auto-rotate="false"
  data-rotation-speed="{{ section.settings.rotation_speed }}"
>
  <header class="homepage__topbar" aria-label="{{ section.settings.brand_name | escape }} home navigation">
    <button class="homepage__icon-button homepage__menu-button" type="button" data-homepage-menu-toggle aria-controls="HomepageMenu-{{ section.id }}" aria-expanded="false">
      <span class="visually-hidden">Open menu</span>
      {{ 'icon-hamburger.svg' | inline_asset_content }}
    </button>

    <nav class="homepage__topnav" aria-label="Primary navigation">
      <a href="{{ routes.all_products_collection_url }}">Collection</a>
      <a href="/pages/about">About</a>
    </nav>

    <a class="homepage__brand" href="{{ routes.root_url }}" aria-label="{{ section.settings.brand_name | escape }}">
      <img src="{{ 'cow _1.png' | asset_url }}" alt="{{ section.settings.brand_name | escape }}" loading="eager">
    </a>

    <div class="homepage__actions">
      <a class="homepage__utility-link" href="{{ routes.all_products_collection_url }}">Shop</a>
      {%- if shop.customer_accounts_enabled -%}
        <a class="homepage__icon-button" href="{{ routes.account_url }}" aria-label="Account">
          {{ 'icon-account.svg' | inline_asset_content }}
        </a>
      {%- endif -%}
      <a class="homepage__icon-button" href="{{ routes.cart_url }}" aria-label="Cart">
        {{ 'icon-cart.svg' | inline_asset_content }}
      </a>
    </div>
  </header>

  <div class="homepage__stage" data-homepage-stage>
    <div class="homepage__menu" id="HomepageMenu-{{ section.id }}" data-homepage-menu>
      <nav class="homepage__nav" aria-label="Site navigation">
        {%- assign menu_items = section.settings.menu_items | newline_to_br | split: '<br />' -%}
        {%- for item in menu_items -%}
          {%- assign item_text = item | strip -%}
          {%- if item_text != blank -%}
            {%- liquid
              assign item_link = default_menu_link
              assign normalized_item_text = item_text | downcase
              if normalized_item_text == 'home'
                assign item_link = routes.root_url
              elsif normalized_item_text == 'maker'
                assign item_link = '/pages/about#maker'
              elsif normalized_item_text == 'collection'
                assign item_link = routes.all_products_collection_url
              elsif normalized_item_text == 'about'
                assign item_link = '/pages/about'
              elsif normalized_item_text == 'cart'
                assign item_link = routes.cart_url
              elsif normalized_item_text == 'sign in'
                assign item_link = routes.account_url
              elsif normalized_item_text == 'contact'
                assign item_link = '/pages/about#contact'
              endif
            -%}
            <a
              class="homepage__nav-link{% if item_text == 'SALE' or item_text == 'Sale' or item_text == 'sale' %} homepage__nav-link--sale{% endif %}"
              href="{{ item_link }}"
            >
              {{ item_text | escape }}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </nav>

      <div class="homepage__socials" aria-label="Social links">
        <a href="{{ settings.social_instagram_link | default: '#' }}" aria-label="Instagram">
          {{ 'icon-instagram.svg' | inline_asset_content }}
        </a>
        <a href="{{ settings.social_facebook_link | default: '#' }}" aria-label="Facebook">
          {{ 'icon-facebook.svg' | inline_asset_content }}
        </a>
      </div>
    </div>

    <div class="homepage__hero-copy">
      {%- if section.settings.hero_kicker != blank -%}
        <p class="homepage__hero-kicker">{{ section.settings.hero_kicker | escape }}</p>
      {%- endif -%}
      <h1 class="homepage__hero-title">{{ section.settings.hero_title | escape }}</h1>
      <p class="homepage__hero-text">{{ section.settings.hero_copy | escape }}</p>
      <a class="homepage__hero-link" href="{{ routes.all_products_collection_url }}">{{ section.settings.hero_link_label | escape }}</a>
    </div>

    <div class="homepage__orbit-wrap" aria-label="{{ section.settings.orbit_label | escape }}">
      <div class="homepage__orbit homepage__orbit--single" data-homepage-orbit style="--homepage-model-count: 1;">
        {%- if model_blocks.size > 0 -%}
          {%- for block in model_blocks -%}
            {%- liquid
              assign linked_product = block.settings.product
              assign item_link = block.settings.link
              if linked_product != blank
                assign item_link = linked_product.url
              endif
              if item_link == blank
                assign item_link = routes.all_products_collection_url
              endif
              assign item_label = block.settings.label
              if item_label == blank and linked_product != blank
                assign item_label = linked_product.title
              endif
              if item_label == blank
              assign item_label = 'X piece'
              endif
            -%}
            <article
              class="homepage__model homepage__model--{{ block.settings.model_style }}"
              style="--homepage-model-index: {{ forloop.index0 }};"
              {{ block.shopify_attributes }}
            >
              <button class="homepage__model-button" type="button" aria-label="Spin {{ item_label | escape }} 3D model">
                <span class="homepage__model-object" aria-hidden="true">
                  <span class="homepage__model-gem"></span>
                  <span class="homepage__model-ring"></span>
                  <span class="homepage__model-stone"></span>
                </span>
              </button>
              <a class="homepage__model-label" href="{{ item_link }}" data-label="{{ item_label | escape }}">
                <span class="homepage__model-label-text">{{ item_label | escape }}</span>
              </a>
            </article>
          {%- endfor -%}
        {%- else -%}
          {%- for placeholder_index in (1..4) -%}
          <article
            class="homepage__model homepage__model--style-{{ placeholder_index }}"
            style="--homepage-model-index: {{ forloop.index0 }};"
          >
            <button class="homepage__model-button" type="button" aria-label="Spin X piece 3D model">
              <span class="homepage__model-object" aria-hidden="true">
                <span class="homepage__model-gem"></span>
                <span class="homepage__model-ring"></span>
                <span class="homepage__model-stone"></span>
              </span>
            </button>
            <a class="homepage__model-label" href="{{ routes.all_products_collection_url }}" data-label="X piece">
              <span class="homepage__model-label-text">X piece</span>
            </a>
          </article>
          {%- endfor -%}
        {%- endif -%}
      </div>
      <button class="homepage__control homepage__control--prev" type="button" data-homepage-prev aria-label="Previous model">&lsaquo;</button>
      <button class="homepage__control homepage__control--next" type="button" data-homepage-next aria-label="Next model">&rsaquo;</button>
    </div>

  </div>

  <div class="homepage__video-section">
    <div class="homepage__video-shell">
      {%- if section.settings.video_url != blank -%}
        <deferred-media class="homepage__video media deferred-media no-js-hidden" data-media-id="{{ section.settings.video_url.id }}">
          <button
            id="Deferred-Poster-{{ section.settings.video_url.id }}"
            class="homepage__video-poster deferred-media__poster"
            type="button"
            aria-label="{{ section.settings.video_button_label | escape }}"
          >
            {%- if video_image != blank -%}
              {{ video_image | image_url: width: 1600 | image_tag:
                loading: 'lazy',
                widths: '375, 550, 750, 1100, 1500, 1600',
                sizes: '(min-width: 990px) 88vw, 92vw',
                alt: section.settings.video_alt
              }}
            {%- else -%}
              <span class="homepage__video-placeholder"></span>
            {%- endif -%}
            <span class="homepage__play" aria-hidden="true">{{ 'icon-play.svg' | inline_asset_content }}</span>
          </button>
          <template>
            {%- if section.settings.video_url.type == 'youtube' -%}
              <iframe src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?enablejsapi=1&autoplay=1" class="js-youtube" allow="autoplay; encrypted-media" allowfullscreen title="{{ section.settings.video_button_label | escape }}"></iframe>
            {%- else -%}
              <iframe src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1" class="js-vimeo" allow="autoplay; encrypted-media" allowfullscreen title="{{ section.settings.video_button_label | escape }}"></iframe>
            {%- endif -%}
          </template>
        </deferred-media>
      {%- else -%}
        <button class="homepage__video homepage__video-poster" type="button" aria-label="{{ section.settings.video_button_label | escape }}">
          {%- if video_image != blank -%}
            {{ video_image | image_url: width: 1600 | image_tag:
              loading: 'lazy',
              widths: '375, 550, 750, 1100, 1500, 1600',
              sizes: '(min-width: 990px) 88vw, 92vw',
              alt: section.settings.video_alt
            }}
          {%- else -%}
            <span class="homepage__video-placeholder"></span>
          {%- endif -%}
          <span class="homepage__play" aria-hidden="true">{{ 'icon-play.svg' | inline_asset_content }}</span>
        </button>
      {%- endif -%}
    </div>
  </div>

  <section class="homepage__featured" aria-labelledby="HomepageFeatured-{{ section.id }}">
    <header class="homepage__featured-header">
      <p class="homepage__featured-kicker">{{ section.settings.featured_kicker | escape }}</p>
      <h2 class="homepage__featured-title" id="HomepageFeatured-{{ section.id }}">
        {{ section.settings.featured_title | escape }}
      </h2>
    </header>

    <div class="homepage__featured-list">
      {%- if featured_blocks.size > 0 -%}
        {%- for block in featured_blocks -%}
          {%- liquid
            assign featured_product = block.settings.product
            assign featured_link = block.settings.link
            assign featured_image = block.settings.image
            assign featured_title = block.settings.title
            assign featured_price = block.settings.price
            if featured_product != blank
              assign featured_link = featured_product.url
              assign featured_title = featured_product.title
              assign featured_price = featured_product.price | money
              if featured_image == blank
                assign featured_image = featured_product.featured_image
              endif
            endif
            if featured_link == blank
              assign featured_link = routes.all_products_collection_url
            endif
          -%}
          <a
            class="homepage__featured-piece homepage__featured-piece--{{ block.settings.placeholder_style }}"
            href="{{ featured_link }}"
            {{ block.shopify_attributes }}
          >
            <span class="homepage__featured-media">
              {%- if featured_image != blank -%}
                {{ featured_image | image_url: width: 1200 | image_tag:
                  loading: 'lazy',
                  widths: '360, 540, 720, 960, 1200',
                  sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                  alt: featured_title
                }}
              {%- else -%}
                <span class="homepage__featured-placeholder" aria-hidden="true">
                  <span class="homepage__featured-placeholder-ring"></span>
                  <span class="homepage__featured-placeholder-stone"></span>
                </span>
              {%- endif -%}
            </span>
            <span class="homepage__featured-copy">
              <span class="homepage__featured-index">{{ forloop.index | prepend: '0' }}</span>
              <span class="homepage__featured-name">{{ featured_title | escape }}</span>
              <span class="homepage__featured-price">{{ featured_price | escape }}</span>
            </span>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for placeholder_index in (1..3) -%}
          <a class="homepage__featured-piece homepage__featured-piece--style-{{ placeholder_index }}" href="{{ routes.all_products_collection_url }}">
            <span class="homepage__featured-media">
              <span class="homepage__featured-placeholder" aria-hidden="true">
                <span class="homepage__featured-placeholder-ring"></span>
                <span class="homepage__featured-placeholder-stone"></span>
              </span>
            </span>
            <span class="homepage__featured-copy">
              <span class="homepage__featured-index">{{ forloop.index | prepend: '0' }}</span>
              <span class="homepage__featured-name">Featured piece</span>
              <span class="homepage__featured-price">Explore</span>
            </span>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </section>
</section>

{% schema %}
{
  "name": "Homepage 3D orbit",
  "tag": "section",
  "class": "section-homepage",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "Milk N Rose"
    },
    {
      "type": "textarea",
      "id": "menu_items",
      "label": "Menu items",
      "default": "Home\nCollection\nAbout\nCart"
    },
    {
      "type": "text",
      "id": "hero_kicker",
      "label": "Hero kicker",
      "default": ""
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero title",
      "default": "New available"
    },
    {
      "type": "textarea",
      "id": "hero_copy",
      "label": "Hero copy",
      "default": "Explore handmade pieces through a rotating product orbit."
    },
    {
      "type": "text",
      "id": "hero_link_label",
      "label": "Hero link label",
      "default": "View collection"
    },
    {
      "type": "url",
      "id": "default_menu_link",
      "label": "Default menu link"
    },
    {
      "type": "text",
      "id": "orbit_label",
      "label": "Orbit accessibility label",
      "default": "Interactive X product model orbit"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate model orbit",
      "default": true
    },
    {
      "type": "range",
      "id": "rotation_speed",
      "label": "Rotation speed",
      "min": 8,
      "max": 30,
      "step": 1,
      "unit": "s",
      "default": 18
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Process video URL",
      "accept": [
        "youtube",
        "vimeo"
      ]
    },
    {
      "type": "image_picker",
      "id": "video_image",
      "label": "Process video poster"
    },
    {
      "type": "text",
      "id": "video_alt",
      "label": "Video poster alt text",
      "default": "Jewelry making process close-up"
    },
    {
      "type": "text",
      "id": "video_button_label",
      "label": "Video play label",
      "default": "Play the making process video"
    },
    {
      "type": "text",
      "id": "featured_kicker",
      "label": "Featured pieces kicker",
      "default": "Selected objects"
    },
    {
      "type": "text",
      "id": "featured_title",
      "label": "Featured pieces title",
      "default": "Featured pieces"
    }
  ],
  "blocks": [
    {
      "type": "model_item",
      "name": "Model item",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Fallback link"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "X piece"
        },
        {
          "type": "select",
          "id": "model_style",
          "label": "Placeholder model style",
          "options": [
            {
              "value": "style-1",
              "label": "Blue charm"
            },
            {
              "value": "style-2",
              "label": "Green stone"
            },
            {
              "value": "style-3",
              "label": "Pink pearl"
            },
            {
              "value": "style-4",
              "label": "Silver pendant"
            }
          ],
          "default": "style-1"
        }
      ]
    },
    {
      "type": "featured_piece",
      "name": "Featured piece",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Fallback image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Fallback link"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Fallback title",
          "default": "Featured piece"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Fallback price",
          "default": "Explore"
        },
        {
          "type": "select",
          "id": "placeholder_style",
          "label": "Placeholder style",
          "options": [
            {
              "value": "style-1",
              "label": "Silver"
            },
            {
              "value": "style-2",
              "label": "Rose"
            },
            {
              "value": "style-3",
              "label": "Silver"
            }
          ],
          "default": "style-1"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Homepage 3D orbit",
      "blocks": [
        {
          "type": "model_item",
          "settings": {
            "label": "Pearl loop",
            "model_style": "style-1"
          }
        },
        {
          "type": "model_item",
          "settings": {
            "label": "Green drop",
            "model_style": "style-2"
          }
        },
        {
          "type": "model_item",
          "settings": {
            "label": "Rose charm",
            "model_style": "style-3"
          }
        },
        {
          "type": "model_item",
          "settings": {
            "label": "Silver piece",
            "model_style": "style-4"
          }
        }
      ]
    }
  ]
}
{% endschema %}
